# ==============================================================================
# GLOBAL EXCHANGE (GX) & BITX CORE - VARIÁVEIS DE AMBIENTE (RENDER & LOCAL)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PONTE COM A BITX CORE BLOCKCHAIN (RENDER / GITHUB)
# ------------------------------------------------------------------------------
# URL do Web Service da BitX Core hospedado no Render (ou local)
# Exemplo: https://bitx-core.onrender.com ou http://localhost:3001
BITX_CORE_API_URL=https://bitx-core.onrender.com

# Segredo compartilhado entre a Global Exchange e a BitX Core para autenticação mútua
BITX_CORE_WEBHOOK_SECRET=bitx_sec_2026_gx

# URL pública da própria Global Exchange no Render
GX_PUBLIC_URL=https://global-exchange.onrender.com

# Cotação cambial base USD / BRL para paridades e conversões
USD_BRL_RATE=5.70

# ------------------------------------------------------------------------------
# 2. BANCO DO BRASIL PIX (PRODUÇÃO & SANDBOX)
# ------------------------------------------------------------------------------
# Chave Pix CNPJ oficial da Engecema (apenas números ou formatado)
BB_PIX_KEY=05368602000110

# Ambiente: 'production' para API mTLS real ou 'sandbox'
BB_ENV=production

# Credenciais obtidas no Portal Developers BB
BB_CLIENT_ID=
BB_CLIENT_SECRET=
BB_GW_APP_KEY=

# ------------------------------------------------------------------------------
# 3. CONTROLE DE ACESSO & ADMINISTRAÇÃO GLOBAL EXCHANGE
# ------------------------------------------------------------------------------
# E-mails com permissão pré-aprovada de Administrador Geral (separados por vírgula)
GX_ADMIN_EMAILS=admin@engecema.com.br,diretoria@engecema.com.br,financeiro@engecema.com.br

# Caminho do arquivo de persistência de dados local
GX_DATA_FILE=./data/gx-data.json

# ------------------------------------------------------------------------------
# 4. SUPABASE (OPCIONAL / SINCRONIZAÇÃO EM NUVEM)
# ------------------------------------------------------------------------------
GX_SUPABASE_URL=
GX_SUPABASE_PUBLISHABLE_KEY=
GX_SUPABASE_SECRET_KEY=
GX_SUPABASE_SERVICE_ROLE_KEY=