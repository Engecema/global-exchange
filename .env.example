# =============================================================================
# 1. COMUNICAÇÃO BIDIRECIONAL ENTRE GLOBAL EXCHANGE E BITX CORE NO RENDER
# =============================================================================
# URL pública do repositório BitX Core rodando no Render (ex: https://bitx-core.onrender.com)
BITX_CORE_API_URL=
# Token ou segredo de segurança para autenticar requisições entre Global Exchange e BitX Core
BITX_CORE_WEBHOOK_SECRET=
# URL pública desta aplicação Global Exchange no Render (ex: https://global-exchange.onrender.com)
GX_PUBLIC_URL=
# Cotação base do Dólar Americano em Reais (USD / BRL), padrão 5.70
USD_BRL_RATE=5.70

# =============================================================================
# 2. BANCO DO BRASIL - CREDENCIAIS MTLS & PIX OFICIAL (PRODUÇÃO)
# =============================================================================
BB_CLIENT_ID=
BB_CLIENT_SECRET=
BB_ENV=production
BB_GW_APP_KEY=
BB_PIX_KEY=05368602000110

# =============================================================================
# 3. SUPABASE, DADOS E ADMINISTRAÇÃO INSTITUCIONAL
# =============================================================================
GX_ADMIN_EMAILS=geonimatos42@gmail.com,geonimatos31@hotmail.com,geoniclementino31@gmail.com
GX_DATA_FILE=
GX_SUPABASE_PUBLISHABLE_KEY=
GX_SUPABASE_SECRET_KEY=
GX_SUPABASE_SERVICE_ROLE_KEY=
GX_SUPABASE_URL=

# =============================================================================
# NOTA PARA O REPOSITÓRIO BITX CORE NO RENDER:
# No repositório BitX Core, configure as seguintes variáveis espelho:
# - GX_API_URL=https://global-exchange.onrender.com
# - GX_WEBHOOK_URL=https://global-exchange.onrender.com/api/bitx/transaction-notify
# - BITX_WEBHOOK_SECRET=<mesmo_token_de_BITX_CORE_WEBHOOK_SECRET>
# =============================================================================